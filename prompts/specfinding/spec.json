{
    "type": "object",
    "description": "The structured response from the Story Conductor.",
    "properties": {
        "conductor_thought_process": {
            "type": "string",
            "description": "Internal monologue applying Narrative Rules, polling Engines, and calculating logic."
        },
        "response_mode": {
            "type": "string",
            "description": "The active command mode determining the data structure.",
            "enum": [
                "initialization",
                "plot_plan",
                "ask_for_options",
                "set_a_scene"
            ]
        },
        "full_world_state_json": {
            "type": "string",
            "description": "The complete, serialized JSON (or YAML) World State Document to establish the story logic and characters. Only set if response_mode is 'initialization'."
        },
        "plan_or_options": {
            "type": "array",
            "description": "Either or chronological sequence of plot events (iff response_mode is 'plot_plan') or a collection of possible next steps (iff response_mode is 'ask_for_options').",
            "items": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string",
                        "description": "A short name for this beat or option."
                    },
                    "beat_summary": {
                        "type": "string",
                        "description": "The narrative description of the event."
                    },
                    "start_datetime": {
                        "type": "string",
                        "description": "In-world timestamp."
                    },
                    "time_since_previous": {
                        "type": "string",
                        "description": "Diegetic time elapsed."
                    },
                    "state_change_summary": {
                        "type": "string",
                        "description": "A brief description of how the world state changes in this beat."
                    }
                },
                "required": [
                    "title",
                    "beat_summary",
                    "start_datetime",
                    "time_since_previous",
                    "state_change_summary"
                ],
                "propertyOrdering": [
                    "title",
                    "beat_summary",
                    "start_datetime",
                    "time_since_previous",
                    "state_change_summary"
                ]
            }
        },
        "world_state_delta_json": {
            "type": "string",
            "description": "A serialized JSON object containing ONLY the fields that have changed or been added. Do not include unchanged data. Only set if response_mode is 'plot_plan' or 'set_a_scene'."
        },
        "scene_plan": {
            "type": "object",
            "description": "A detailed plan for setting a specific scene. Only set if response_mode is 'set_a_scene'.",
            "properties": {
                "goal": {
                    "type": "string"
                },
                "location": {
                    "type": "string"
                },
                "atmosphere": {
                    "type": "string"
                },
                "start_datetime": {
                    "type": "string"
                },
                "estimated_duration": {
                    "type": "string"
                },
                "key_events": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "event_description": {
                                "type": "string"
                            },
                            "word_budget": {
                                "type": "integer"
                            }
                        },
                        "required": [
                            "event_description",
                            "word_budget"
                        ],
                        "propertyOrdering": [
                            "event_description",
                            "word_budget"
                        ]
                    }
                },
                "ending_instruction": {
                    "type": "string"
                }
            },
            "required": [
                "goal",
                "location",
                "atmosphere",
                "start_datetime",
                "estimated_duration",
                "key_events",
                "ending_instruction"
            ],
            "propertyOrdering": [
                "goal",
                "location",
                "atmosphere",
                "start_datetime",
                "estimated_duration",
                "key_events",
                "ending_instruction"
            ]
        }
    },
    "propertyOrdering": [
        "full_world_state_json",
        "beats_or_options",
        "world_state_delta_json",
        "scene_plan",
        "conductor_thought_process",
        "response_mode",
        "output_data"
    ],
    "required": [
        "response_mode"
    ]
}