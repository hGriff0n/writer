{
    "type": "object",
    "properties": {
        "core_concepts": {
            "type": "array",
            "description": "",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "category": {
                        "type": "string",
                        "description": "An optional tag for grouping similar concepts"
                    },
                    "summary": {
                        "type": "string",
                        "description": "High-level description of the broader concept"
                    },
                    "components": {
                        "type": "array",
                        "description": "The list of discrete elements that define this concept. Can be empty if the `summary` is all that's needed",
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string"
                                },
                                "principle": {
                                    "type": "string",
                                    "description": "The core text of the rule, effect, or narrative function."
                                },
                                "when": {
                                    "type": "string",
                                    "description": "Temporal conditions for when this component should be applied. Can be a specific reference to a stage in an overarching progression (ie. Act 1 of 5)"
                                },
                                "target": {
                                    "type": "string",
                                    "description": "Specification of what areas/groups/etc that this component applies to."
                                }
                            },
                            "required": [
                                "name"
                            ]
                        }
                    }
                },
                "required": [
                    "name",
                    "components"
                ]
            }
        },
        "narrative_engines": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "flow_description": {
                        "type": "string"
                    },
                    "current_state": {
                        "type": "string",
                        "description": "MUST be the name of an object in the lifecycle_states array"
                    },
                    "lifecycle_states": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "description": "MUST be 'DORMANT', 'ACTIVE', or 'END"
                                },
                                "dormant": {
                                    "type": "boolean"
                                },
                                "transitions": {
                                    "type": "array",
                                    "description": "A list of possible transitions out of this state.",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "to": {
                                                "type": "string",
                                                "description": "The name of the target state. MUST be the name of an object in the lifecycle_states array"
                                            },
                                            "on": {
                                                "type": "string",
                                                "description": "The narrative condition or event that triggers this transition."
                                            }
                                        },
                                        "required": [
                                            "to",
                                            "on"
                                        ]
                                    }
                                }
                            }
                        }
                    },
                    "active_operations": {
                        "type": "object",
                        "description": "Defines the engine's narrative outputs, including prompts and mandatory rules while in the ACTIVE state",
                        "properties": {
                            "scenario_prompts": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "narrative_mandates": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "hidden_information": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "required": [
                    "name",
                    "flow_description",
                    "current_state",
                    "lifecycle_states"
                ]
            }
        },
        "narrative_rules": {
            "type": "array",
            "description": "The concrete implementation layer, intended to be a read-only reference library for later generation processes to ensure procedural consistency.",
            "items": {
                "type": "object",
                "description": "A named container for a set of related rules that work together to implement a complex game mechanic or system.",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "rules": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": { "type": "string" },
                                "mandate": {
                                    "type": "string",
                                    "description": "A simple, declarative instruction or principle that MUST always be followed."
                                },
                                "event": {
                                    "type": "object",
                                    "description": "A trigger-based rule that executes a collection of actions when its `on` condition is met",
                                    "properties": {
                                        "on": {
                                            "type": "string"
                                        },
                                        "do": {
                                            "type": "array",
                                            "description": "The ordered list of steps to execute. Steps can be simple instructions or formatted calls to named Procedures",
                                            "items": {
                                                "type": "string"
                                            }
                                        }
                                    },
                                    "required": [
                                        "on",
                                        "do"
                                    ]
                                },
                                "lookup_table": {
                                    "type": "object",
                                    "description": "A data table for looking up outcomes based on inputs",
                                    "properties": {
                                        "desc": {
                                            "type": "string"
                                        },
                                        "cols": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        "rows": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        }
                                    },
                                    "required": [
                                        "cols",
                                        "rows"
                                    ]
                                },
                                "procedure": {
                                    "type": "array",
                                    "description": "A named, reusable sequence of instructions to execute when called. Used for generation, calculations, or any complex, repeatable action.",
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "beat_generation": {
                                    "type": "object",
                                    "description": "A special rule that describes how plot beats should be built from the recommendations of the narrative engines.",
                                    "properties": {
                                        "calibration": {
                                            "type": "string",
                                            "description": "Checks to run before any further generation"
                                        },
                                        "rules": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "name": {"type": "string"},
                                                    "text": {
                                                        "type": "string",
                                                        "description": "Instructions for how proposed plot beats should weighted"
                                                    },
                                                    "addl": {
                                                        "type": "array",
                                                        "description": "Additional modifications and adjustments to specific circumstances",
                                                        "items": {
                                                            "type": "string"
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            },
                            "required": ["name"]
                        }
                    }
                },
                "required": [
                    "name",
                    "rules"
                ]
            }
        }
    },
    "required": [
        "core_concepts",
        "narrative_engines",
        "narrative_rules"
    ]
}